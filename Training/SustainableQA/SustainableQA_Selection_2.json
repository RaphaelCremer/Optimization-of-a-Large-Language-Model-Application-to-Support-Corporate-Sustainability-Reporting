      "question": "Which internationally recognized sustainability standards are used by CA Immo to certify its buildings?",
      "answer": "BREEAM, DGNB, LEED, SmartScore, WELL, WiredScore",
      "type": "Factoid",
      "tag": "Sustainability",
      "question_id": "train:001622:qa_pairs_factoid:0001",
