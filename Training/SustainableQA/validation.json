      "qa_pairs_non_factoid": {
        "qa_pairs": [
          {
            "question": "Why is conducting an impact analysis critical for aligning a bank's portfolio with sustainable development goals, and how does it support ESG priorities?",
            "answer": "The purpose of conducting an impact analysis is to identify the most significant impact areas of a bank's portfolio and determine priority areas for target-setting. This process ensures that the bank aligns its activities with sustainable development goals and continuously improves the scope and quality of its analysis over time.",
            "type": "Descriptive, non-factoid",
            "tag": "ESG"
          },
          {
            "question": "How should a bank define the scope of its impact analysis to ensure comprehensive coverage of its ESG-related activities across geographies and sectors?",
            "answer": "The scope of a bank's impact analysis should describe which parts of the bank's core business areas, products, and services across its main geographies are included. It should also specify areas not yet included and provide reasons for their exclusion. Additionally, if another approach is used to determine the scale of exposure, it should be elaborated to show how the bank's core activities are considered.",
            "type": "Descriptive, non-factoid",
            "tag": "ESG"
          },
