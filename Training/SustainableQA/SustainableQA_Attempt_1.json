      "question": "Which preventive strategies does SGL Carbon implement to enhance governance against security breaches?",
      "answer": "detection strategies, emergency response plans, employee awareness, mandatory and optional training, multi-factor authentication, regular attack simulations, risk transparency",
      "type": "Factoid",
      "tag": "ESG",
      "question_id": "validation:000729:qa_pairs_factoid:0001",
