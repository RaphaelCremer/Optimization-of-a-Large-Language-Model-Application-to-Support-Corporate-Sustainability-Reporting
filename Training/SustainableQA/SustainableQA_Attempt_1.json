      "question": "Which criteria related to sustainability or compliance allow exceptions to the investment limits?",
      "answer": "EU taxonomy-aligned activities, Paris Agreement, SBTi-validated targets",
      "type": "Factoid",
      "tag": "EU Taxonomy",
      "question_id": "train:006071:qa_pairs_factoid:0001",
